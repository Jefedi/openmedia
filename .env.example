# OpenMedia Platform - Configuration Template
# Copier ce fichier en .env et remplir les valeurs

# =============================================================================
# GENERAL
# =============================================================================
ENVIRONMENT=production  # development, staging, production
DEBUG=false
LOG_LEVEL=info  # debug, info, warning, error, critical

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
POSTGRES_DB=openmedia
POSTGRES_USER=openmedia
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE  # ⚠️ OBLIGATOIRE - Min 16 caractères
POSTGRES_PORT=5432

# =============================================================================
# REDIS CACHE & QUEUE
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD  # ⚠️ OBLIGATOIRE - Min 16 caractères
REDIS_PORT=6379

# =============================================================================
# MEILISEARCH
# =============================================================================
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY  # ⚠️ OBLIGATOIRE - Min 16 caractères
MEILI_ENV=production
MEILI_PORT=7700

# =============================================================================
# API BACKEND
# =============================================================================
API_PORT=8000

# Security - JWT Tokens
SECRET_KEY=CHANGE_ME_SECRET_KEY_64_CHARS_MIN  # ⚠️ OBLIGATOIRE - Générer avec: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_64_CHARS_MIN  # ⚠️ OBLIGATOIRE - Différent de SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Origins autorisées (format JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://yourdomain.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# API Keys - Quotas par défaut
DEFAULT_API_KEY_RATE_LIMIT=100  # Requêtes par heure
DEFAULT_API_KEY_DAILY_LIMIT=2000  # Requêtes par jour

# =============================================================================
# CELERY WORKER
# =============================================================================
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=4  # Nombre de workers simultanés

# =============================================================================
# FRONTEND
# =============================================================================
FRONTEND_PORT=3000
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8000  # URL publique de l'API
NEXT_PUBLIC_APP_NAME=OpenMedia

# =============================================================================
# NGINX PROXY
# =============================================================================
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN_NAME=localhost  # Votre nom de domaine en production

# SSL/TLS
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_CERTIFICATE_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# VERSIONS
# =============================================================================
PYTHON_VERSION=3.11
NODE_VERSION=20

# =============================================================================
# EXTERNAL APIs (Optionnel)
# =============================================================================

# TMDB - The Movie Database
TMDB_API_KEY=  # Optionnel - Pour import de données
TMDB_API_READ_TOKEN=

# Trakt.tv - Synchronisation utilisateur
TRAKT_CLIENT_ID=  # Optionnel - Pour sync Trakt
TRAKT_CLIENT_SECRET=

# OMDb API
OMDB_API_KEY=  # Optionnel - Pour données complémentaires

# =============================================================================
# BACKUP & MONITORING (Optionnel)
# =============================================================================

# Backup automatique
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"  # Cron expression - 3h du matin
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# Sentry - Error tracking
SENTRY_DSN=  # Optionnel
SENTRY_ENVIRONMENT=production

# Monitoring
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

# =============================================================================
# EMAIL (Optionnel - Pour notifications)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@openmedia.example
SMTP_TLS=true

# =============================================================================
# SECURITY
# =============================================================================

# Nombres maximum de tentatives de connexion
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900  # Secondes (15 minutes)

# Session
SESSION_LIFETIME=86400  # Secondes (24 heures)

# HTTPS obligatoire en production
FORCE_HTTPS=true

# =============================================================================
# IMPORT DE DONNÉES
# =============================================================================

# Chemins des datasets IMDb
IMDB_DATASETS_PATH=/data/imdb
IMDB_TITLE_BASICS_URL=https://datasets.imdbws.com/title.basics.tsv.gz
IMDB_TITLE_RATINGS_URL=https://datasets.imdbws.com/title.ratings.tsv.gz
IMDB_TITLE_CREW_URL=https://datasets.imdbws.com/title.crew.tsv.gz
IMDB_NAME_BASICS_URL=https://datasets.imdbws.com/name.basics.tsv.gz

# =============================================================================
# DEVELOPMENT (Ne pas utiliser en production)
# =============================================================================

# Auto-reload pour développement
AUTO_RELOAD=false

# Seed database avec données de test
SEED_DATABASE=false

# Exposer les ports directement (sans Nginx)
EXPOSE_PORTS=false
