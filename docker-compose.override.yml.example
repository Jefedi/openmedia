# Docker Compose Override - Personnalisations locales
#
# Ce fichier montre comment personnaliser la configuration Docker Compose localement
# sans modifier les fichiers de base.
#
# Usage:
# 1. Copiez ce fichier: cp docker-compose.override.yml.example docker-compose.override.yml
# 2. Modifiez docker-compose.override.yml selon vos besoins
# 3. Le fichier override sera automatiquement utilisé par docker-compose
#
# Note: docker-compose.override.yml est dans .gitignore et ne sera pas commité

# =============================================================================
# EXEMPLE 1: Changer tous les ports pour éviter les conflits (RECOMMANDÉ)
# =============================================================================
# Si vous avez d'autres services qui utilisent les ports par défaut,
# décommentez cette section pour utiliser des ports alternatifs.
#
# services:
#   db:
#     ports:
#       - "15432:5432"  # PostgreSQL sur port 15432 au lieu de 5432
#
#   redis:
#     ports:
#       - "16379:6379"  # Redis sur port 16379 au lieu de 6379
#
#   search:
#     ports:
#       - "17700:7700"  # Meilisearch sur port 17700 au lieu de 7700
#     healthcheck:
#       test: ["CMD", "curl", "-f", "http://localhost:7700/health"]
#       interval: 10s
#       timeout: 3s
#       retries: 5
#
#   api:
#     ports:
#       - "18000:8000"  # API sur port 18000 au lieu de 8000
#     depends_on:
#       db:
#         condition: service_healthy
#       redis:
#         condition: service_healthy
#       search:
#         condition: service_healthy
#
#   frontend:
#     ports:
#       - "13000:3000"  # Frontend sur port 13000 au lieu de 3000
#     environment:
#       NEXT_PUBLIC_API_URL: http://localhost:18000
#
#   worker:
#     depends_on:
#       db:
#         condition: service_healthy
#       redis:
#         condition: service_healthy
#       api:
#         condition: service_healthy

# =============================================================================
# EXEMPLE 2: Changer un seul port
# =============================================================================
services:
  # Exemple: Exposer PostgreSQL sur un port différent
  # db:
  #   ports:
  #     - "5433:5432"

  # Exemple: Utiliser un port différent pour le frontend
  # frontend:
  #   ports:
  #     - "3001:3000"

  # Exemple: Monter un volume local pour les backups
  # db:
  #   volumes:
  #     - ./local-backups:/backups

  # Exemple: Augmenter la mémoire de Redis
  # redis:
  #   command: >
  #     redis-server
  #     --requirepass ${REDIS_PASSWORD}
  #     --maxmemory 1gb
  #     --maxmemory-policy allkeys-lru

  # Exemple: Ajouter des variables d'environnement supplémentaires à l'API
  # api:
  #   environment:
  #     - CUSTOM_VAR=value
  #   volumes:
  #     - ./custom-scripts:/app/custom-scripts

# =============================================================================
# EXEMPLE 3: Ajouter des services de monitoring
# =============================================================================

  # Exemple: Ajouter un service de monitoring
  # prometheus:
  #   image: prom/prometheus:latest
  #   container_name: openmedia_prometheus
  #   ports:
  #     - "9090:9090"
  #   volumes:
  #     - ./monitoring/prometheus.yml:/etc/prometheus/prometheus.yml
  #   networks:
  #     - openmedia_network

  # Exemple: Ajouter Adminer pour gérer la base de données
  # adminer:
  #   image: adminer:latest
  #   container_name: openmedia_adminer
  #   restart: unless-stopped
  #   ports:
  #     - "8080:8080"
  #   environment:
  #     ADMINER_DEFAULT_SERVER: db
  #   depends_on:
  #     - db
  #   networks:
  #     - openmedia_network

  # Exemple: Ajouter Redis Commander pour visualiser Redis
  # redis-commander:
  #   image: rediscommander/redis-commander:latest
  #   container_name: openmedia_redis_commander
  #   restart: unless-stopped
  #   ports:
  #     - "8081:8081"
  #   environment:
  #     REDIS_HOSTS: local:redis:6379:0:${REDIS_PASSWORD}
  #   depends_on:
  #     - redis
  #   networks:
  #     - openmedia_network
